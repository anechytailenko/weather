{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocationServiceSettings": {
    "MaxLocations": 9,
    "EnableDelete": true
  },
  "AlertServiceSettings": {
    "MaxAlerts": 50,
    "EnableDelete": false
  },
  "WeatherService": {
    "DefaultPaginationLimit": 10,
    "DefaultPaginationOffset": 0,
    "DefaultTemperatureUnit": "Celsius"
  }
}
