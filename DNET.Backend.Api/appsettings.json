{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocationService": {
    "MaxLocations": 30,
    "EnableDelete": true
  },
  "AlertService": {
    "MaxAlerts": 50,
    "EnableDelete": true
  },
  "WeatherService": {
    "DefaultPaginationLimit": 10,
    "DefaultPaginationOffset": 0,
    "DefaultTemperatureUnit": "Celsius"
  },
  "ConnectionStrings": {
    "WeatherAppDb": "Host=localhost;Database=weather_app;Username=postgres;Password=admin"
  }
}
